# The build folder holds ~1.3 GB of staged runtime and reports. Only the
# packaged app executable is tracked so a fresh clone can run it directly;
# every build refreshes that file automatically.
build/*
!build/Personal Agent/
build/Personal Agent/*
!build/Personal Agent/Personal Agent.exe
# Harness reports written when a test runs from backend/.
backend/build/
# Phase 22 engine runtime, models, and state in a dev checkout.
engine-data/
# VS Code counter/extension artifacts.
.VSCodeCounter/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Android companion ---
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
*.apk

# --- Local memory / databases ---
memory/*
!memory/.gitkeep
*.db
*.sqlite
*.sqlite3

