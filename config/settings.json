{
  "agent_name": "Compa",
  "personality_file": "config/personality.md",
  "system_prompt": "Be concise but thorough. Prefer practical steps and concrete examples. Ask a clarifying question when a request is ambiguous. Never invent facts. Respect the user's privacy and keep all work on this machine. When the conversation history or knowledge base contains relevant details, use them and stay consistent with them.",
  "backend": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434/v1",
    "model": "qwen3-vl:8b-instruct",
    "timeout_seconds": 120,
    "temperature": 0.5,
    "max_retries": 1,
    "keep_alive_seconds": 1800,
    "warmup_on_startup": true,
    "model_quantization": "q4_K_M",
    "context_window": 24576,
    "system_prompt_mode": "auto"
  },
  "agent": {
    "max_iterations": 0,
    "max_auto_approved_actions": 0,
    "approval_ttl_seconds": 600,
    "self_improvement_enabled": true,
    "self_improvement_workflow_min_tools": 3
  },
  "memory": {
    "knowledge_base_path": "memory/knowledge_base.md",
    "max_conversations": 100,
    "learn_from_chats": true
  },
  "tools": {
    "max_read_bytes": 1000000,
    "max_search_results": 50,
    "max_search_files": 20000,
    "max_search_seconds": 30,
    "max_unzip_bytes": 209715200,
    "redact_secrets": true,
    "powershell_timeout_seconds": 15,
    "powershell_max_output_chars": 12000
  },
  "automation": {
    "enabled": true,
    "move_duration_seconds": 0.9,
    "highlight_seconds": 0.5,
    "arm_delay_seconds": 0.4,
    "move_threshold_pixels": 4,
    "max_elements": 60,
    "type_interval_seconds": 0.02,
    "visual_fallback": true,
    "pre_action_validation": true,
    "validation_tolerance_px": 8
  },
  "vision": {
    "enabled": true,
    "embed_model": "clip-ViT-B-32",
    "index_path": "memory/vision_index.sqlite3",
    "scan_roots": ["~"],
    "batch_size": 8,
    "scan_interval_seconds": 600,
    "max_images": 150000,
    "max_file_mb": 50,
    "exclude_paths": [],
    "min_confidence_z": 3.0,
    "min_result_z": 2.4,
    "dedupe_threshold": 0.995,
    "screen_model": "qwen3-vl:8b-instruct",
    "screen_timeout_seconds": 180,
    "screen_max_width": 1600,
    "screen_max_tokens": 700
  }
}
